#!name=Surge HTTPS MITM Test
#!desc=Log a Cloudflare HTTPS response without changing it. Requires a trusted Surge MITM certificate.

[Script]
HTTPS MITM Test = type=http-response, pattern=^https://www\.cloudflare\.com/cdn-cgi/trace, script-path=https://raw.githubusercontent.com/ZzkRereal/-/main/surge-tests/https-mitm-test.js, requires-body=false, timeout=15

[MITM]
hostname = %APPEND% www.cloudflare.com
